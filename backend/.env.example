# ==============================================================================
# Drishti-Safe / CrowdFlow Dashboard - Backend Environment Configuration
# ==============================================================================

# Server HTTP Port
PORT=3000

# Pusher Realtime Service Keys
# (Optional: Native Server-Sent Events /api/stream works 100% offline without Pusher)
PUSHER_APP_ID=dummy_app_id
PUSHER_KEY=dummy_key
PUSHER_SECRET=dummy_secret
PUSHER_CLUSTER=ap2

# Node Environment
NODE_ENV=development
